# AdForge environment variables
# Copy this file to .env. The default local engine works without any API keys.

# Production engine: faceless (free/local), avatar (Kling), or veo (fal.ai)
ENGINE=faceless

# Optional; required only by avatar and veo engines.
# https://fal.ai/dashboard/keys
FAL_KEY=

# Optional OpenAI enrichment for hook generation and predicted scoring.
OPENAI_API_KEY=
# Default: gpt-6.1-sol
OPENAI_MODEL=

# Hook planner: auto (LLM when configured), template, or llm
PLANNER_MODE=auto

# Text-to-speech: auto (Edge with Piper fallback), edge, or piper
TTS_BACKEND=auto
TTS_VOICE_TR_FEMALE=tr-TR-EmelNeural
TTS_VOICE_TR_MALE=tr-TR-AhmetNeural
TTS_VOICE_EN_FEMALE=en-US-JennyNeural
TTS_VOICE_EN_MALE=en-US-GuyNeural

# Optional fully offline Piper fallback.
# Download: https://github.com/rhasspy/piper/releases
PIPER_PATH=
PIPER_MODEL=

# Local rendering
LOCAL_CONCURRENCY=1
RENDER_FPS=25
RENDER_CRF=21
# Remove the product background. Requires @imgly/background-removal-node.
BG_REMOVAL=0
# Keep intermediate render files for debugging.
KEEP_TEMP=0
# Optional system FFmpeg path. The default is ffmpeg-static.
# FFMPEG_PATH=

# Intermediate render directory. Defaults to the system temporary directory.
# Keep this outside OneDrive to avoid intermittent sync-lock conversion failures.
# WORK_DIR=

# Parallel request limit for hosted fal.ai engines.
MAX_CONCURRENCY=4

# Server-side paid-generation spending ceiling per campaign in USD.
MAX_SPEND_USD=5

PORT=3000

# Minimum impressions required before a variant or angle affects learning.
# LEARN_MIN_IMPRESSIONS=1000

# AI disclosure for faceless/avatar videos. Defaults to a standard localized label.
# AI_DISCLOSURE=AI-generated
# AI_DISCLOSURE=off
