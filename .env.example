# === AdForge ortam degiskenleri ===
# Bu dosyayi .env olarak kopyala ve degerleri doldur.

# fal.ai API anahtari (ZORUNLU) — gorsel, video, TTS, lipsync, altyazi modelleri icin.
# Format: uuid:hex   ornek: a1b2c3d4-...-ef12...:9876...fedcba
# https://fal.ai/dashboard/keys
FAL_KEY=

# Anthropic API anahtari (OPSIYONEL) — hook uretimi ve skorlamayi LLM ile zenginlestirir.
# Bos birakilirsa AdForge dahili sablon-tabanli hook uretici + heuristik skorlayici kullanir
# (yalnizca FAL_KEY ile de calisir). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Hook uretici/skorlayici modu: "auto" (anahtar varsa LLM, yoksa sablon) | "template" | "llm"
PLANNER_MODE=auto

# Ayni anda kac varyantin uretim cagrisi paralel kossun (fal rate limit'ine gore)
MAX_CONCURRENCY=4

# Port
PORT=3000
