# === AdForge ortam degiskenleri ===
# Bu dosyayi .env olarak kopyala. HICBIR ANAHTAR OLMADAN da calisir:
# varsayilan motor yerel + ucretsizdir (faceless: edge-tts + ffmpeg + sharp).

# --- Uretim motoru ---
# faceless (yerel, ucretsiz, varsayilan)
# avatar   (hibrit ust seviye: yerel TTS + Kling lipsync, ~$0.60/video, FAL_KEY ister)
# veo      (fal.ai Veo/Seedance, ~$1.20+/video, FAL_KEY ister)
ENGINE=faceless

# fal.ai API anahtari (OPSIYONEL) — yalnizca 'avatar' ve 'veo' motorlari icin gerekli.
# Bos birakilirsa yerel motor calisir, fal'a hicbir cagri gitmez.
# https://fal.ai/dashboard/keys
FAL_KEY=

# OpenAI API anahtari (OPSIYONEL) — hook uretimi ve skorlamayi LLM ile zenginlestirir.
# Bos birakilirsa sablon-tabanli hook uretici + kural tabanli yerel skorlayici kullanilir.
OPENAI_API_KEY=
# Kullanilacak OpenAI modeli (opsiyonel; varsayilan: gpt-6.1-sol)
OPENAI_MODEL=

# Hook uretici modu: "auto" (anahtar varsa LLM, yoksa sablon) | "template" | "llm"
PLANNER_MODE=auto

# --- TTS (yerel motor seslendirmesi) ---
# auto (edge, olmazsa piper) | edge | piper
TTS_BACKEND=auto
# Edge neural sesleri (ucretsiz). TR ve EN ayri ayri override edilebilir:
TTS_VOICE_TR_FEMALE=tr-TR-EmelNeural
TTS_VOICE_TR_MALE=tr-TR-AhmetNeural
TTS_VOICE_EN_FEMALE=en-US-JennyNeural
TTS_VOICE_EN_MALE=en-US-GuyNeural
# Tamamen cevrimdisi yedek (OPSIYONEL): rhasspy/piper Windows binary'si + tr_TR ses modeli.
# Indir: https://github.com/rhasspy/piper/releases (piper_windows_amd64.zip + tr_TR-*-medium.onnx)
PIPER_PATH=
PIPER_MODEL=

# --- Yerel render ayarlari ---
# Ayni anda kac yerel video render edilsin (CPU/RAM sinirli — 1 onerilir)
LOCAL_CONCURRENCY=1
RENDER_FPS=25
RENDER_CRF=21
# 1 = urun arka planini kaldir (once: npm i @imgly/background-removal-node; yavas, RAM ister)
BG_REMOVAL=0
# 1 = ara render dosyalarini silme (debug)
KEEP_TEMP=0
# Sistem ffmpeg'i kullanmak istersen yolunu ver (varsayilan: npm'deki ffmpeg-static)
# FFMPEG_PATH=

# Render ARA dosyalari icin calisma dizini. Varsayilan: sistem temp (OneDrive DISI).
# OneDrive altinda calisiyorsan bunu DEGISTIRME — ara dosyalarin OneDrive'da olmasi
# senkron kilidi -> aralikli "Conversion failed" hatasina yol acar.
# WORK_DIR=

# fal motorlari icin paralel cagri limiti (fal rate limit'ine gore)
MAX_CONCURRENCY=4

# Ucretli (avatar/veo) tek kampanya harcama tavani ($). Kazara buyuk kampanyayi
# sunucu tarafinda engeller (frontend onayindan bagimsiz). Yerel motor bu limite tabi degil.
MAX_SPEND_USD=5

# Port
PORT=3000
